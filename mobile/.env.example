# ==========================================
# TrustLoop Mobile Environment Configuration
# Copy this file to .env in /mobile
# ==========================================

# 1. PHYSICAL PHONE (Expo Go via Wi-Fi):
# Must use your computer's LAN IP address on your Wi-Fi network (NOT localhost).
# Example (detected LAN IP on this host):
EXPO_PUBLIC_API_URL=http://192.168.137.215:8080

# 2. ANDROID EMULATOR:
# The Android emulator connects to host localhost via 10.0.2.2
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# 3. IOS SIMULATOR OR WEB:
# EXPO_PUBLIC_API_URL=http://localhost:8080
